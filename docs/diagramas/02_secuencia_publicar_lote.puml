@startuml secuencia_publicar_lote
' =====================================================================
' PAPACOL - DIAGRAMA DE SECUENCIA DEL FLUJO PRINCIPAL
' Caso de uso CU-05: Publicar un lote de papa (RF-04, CFV-02)
' Muestra el recorrido completo end-to-end: interfaz -> API -> capas
' del backend -> base de datos -> respuesta.
' =====================================================================
skinparam backgroundColor White
skinparam shadowing false
skinparam sequence {
  ArrowColor #4A7C3F
  LifeLineBorderColor #4A7C3F
  ParticipantBorderColor #4A7C3F
  ParticipantBackgroundColor #EAF4E3
  ActorBorderColor #4A7C3F
}

actor Productor as P
participant "LoteFormScreen\n(Flutter)" as UI
participant "LoteService\n(Flutter)" as FSVC
participant "lote.routes.js\n(Express)" as RT
participant "auth.middleware.js" as MW
participant "lote.controller.js" as CTRL
participant "lote.service.js\n(logica de negocio)" as SVC
participant "lote.model.js\n(acceso a datos)" as MOD
database "PostgreSQL\ntabla lote" as BD

P -> UI : Diligencia el formulario\ny pulsa "Publicar"
activate UI
UI -> UI : Validacion basica del formulario
UI -> FSVC : crearLote(datos, token)
activate FSVC
FSVC -> RT : POST /api/v1/lotes\nAuthorization: Bearer <token>\nBody JSON
activate RT

RT -> MW : requiereAutenticacion()
activate MW
MW -> MW : jwt.verify(token)  (RNF-02)
alt Token invalido o ausente
  MW --> FSVC : 401 {exito:false, mensaje}
else Token valido
  MW -> MW : requiereRol('PRODUCTOR')  (RN-02)
  alt Rol distinto de PRODUCTOR
    MW --> FSVC : 403 {exito:false, mensaje}
  else Rol correcto
    MW --> RT : next()
    deactivate MW
    RT -> CTRL : crear(req, res, next)
    activate CTRL
    CTRL -> SVC : crearLote(usuario, datos)
    activate SVC
    SVC -> SVC : verificarEsProductor()  (RN-02)
    SVC -> SVC : validarDatosLote()  (RN-04, RN-05, RN-06)
    alt Datos invalidos
      SVC --> CTRL : ErrorApp(400, lista de errores)
      CTRL --> FSVC : 400 {exito:false, detalles:[...]}
    else Datos validos
      SVC -> MOD : crear({usuarioId, variedadId, ...})
      activate MOD
      MOD -> BD : INSERT INTO lote (...) \nVALUES ($1..$8) RETURNING lote_id
      activate BD
      BD -> BD : Verifica CHECK ck_lote_precio,\nck_lote_fechas, ck_lote_estado
      BD --> MOD : lote_id
      deactivate BD
      MOD -> BD : SELECT ... JOIN variedad, calibre,\nusuario, municipio WHERE lote_id = $1
      activate BD
      BD --> MOD : Fila completa del lote
      deactivate BD
      MOD --> SVC : objeto lote
      deactivate MOD
      SVC --> CTRL : objeto lote
      deactivate SVC
      CTRL --> FSVC : 201 {exito:true, datos:{lote}}
      deactivate CTRL
    end
  end
end
deactivate RT

FSVC --> UI : Lote creado
deactivate FSVC
UI -> UI : Refresca la lista "Mis lotes"
UI --> P : Mensaje de confirmacion\ny lote visible en pantalla
deactivate UI

note over BD
  La transaccion del INSERT es atomica (RNF-05).
  Si alguna restriccion CHECK falla, PostgreSQL
  revierte y el middleware de errores traduce el
  codigo 23514 a un mensaje de negocio (HTTP 400).
end note

@enduml
