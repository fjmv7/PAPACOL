@startuml casos_de_uso_papacol
' =====================================================================
' PAPACOL - DIAGRAMA DE CASOS DE USO
' Alcance: Semestre V (3 CFV del primer incremento)
' Universidad de Cundinamarca - Seccional Ubate
' =====================================================================
left to right direction
skinparam backgroundColor White
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EAF4E3
  BorderColor #4A7C3F
  ArrowColor #4A7C3F
}

actor "Visitante\n(no autenticado)" as Visitante
actor "Productor" as Productor
actor "Comprador" as Comprador

Visitante <|-- Productor
Visitante <|-- Comprador

rectangle "Sistema PAPACOL — Incremento 1 (Semestre V)" {

  package "CFV-01 Registro y autenticacion" {
    usecase "CU-01\nRegistrarse como productor" as CU01
    usecase "CU-02\nRegistrarse como comprador" as CU02
    usecase "CU-03\nIniciar sesion" as CU03
    usecase "CU-04\nConsultar perfil propio" as CU04
  }

  package "CFV-02 Gestion de lotes" {
    usecase "CU-05\nPublicar lote de papa" as CU05
    usecase "CU-06\nConsultar mis lotes" as CU06
    usecase "CU-07\nModificar lote propio" as CU07
    usecase "CU-08\nRetirar lote propio" as CU08
  }

  package "CFV-03 Consulta del catalogo" {
    usecase "CU-09\nConsultar catalogo publico" as CU09
    usecase "CU-10\nFiltrar y ordenar el catalogo" as CU10
    usecase "CU-11\nVer detalle y contacto\ndel productor" as CU11
  }

  usecase "Validar credenciales\n(RN-08)" as CUVAL
  usecase "Verificar autoria\ndel lote (RN-03)" as CUAUT
}

Visitante --> CU01
Visitante --> CU02
Visitante --> CU03
Visitante --> CU09
Visitante --> CU10
Visitante --> CU11

Productor --> CU04
Productor --> CU05
Productor --> CU06
Productor --> CU07
Productor --> CU08

Comprador --> CU04

CU03 ..> CUVAL : <<include>>
CU07 ..> CUAUT : <<include>>
CU08 ..> CUAUT : <<include>>
CU10 ..> CU09  : <<extend>>
CU11 ..> CU09  : <<extend>>

note right of CU05
  RN-02: unicamente un usuario
  con rol PRODUCTOR puede
  crear, modificar o retirar lotes.
end note

note bottom of CU09
  RN-07: el catalogo publico muestra
  unicamente lotes en estado DISPONIBLE.
end note

@enduml
