# PAPACOL - Variables de entorno del backend
# Copie este archivo como .env y ajuste los valores. El archivo .env NUNCA se sube al repositorio.
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=papacol
DB_USER=papacol_app
DB_PASSWORD=cambie_esta_clave
DB_POOL_MAX=10

# Secreto de firma de los tokens JWT. Genere uno propio:  openssl rand -hex 32
JWT_SECRET=cambie_este_secreto_por_uno_aleatorio_de_64_caracteres
JWT_EXPIRACION=8h
BCRYPT_ROUNDS=10
